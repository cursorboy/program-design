  "description": "Live structure visualization + deterministic claim verification for AI-built Next.js apps. Every statement carries a file:line receipt.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://cursorboy.github.io/program-design/",
  "repository": { "type": "git", "url": "https://github.com/cursorboy/program-design.git" },
  "bin": {
